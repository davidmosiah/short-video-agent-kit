{
  "name": "short-video-agent-kit",
  "version": "0.1.11",
  "mcpName": "io.github.davidmosiah/short-video-agent-kit",
  "description": "Agent-first short-form AI video generation CLI and MCP server for Sora, Gemini Veo, xAI/Grok and Seedance/PiAPI.",
  "type": "module",
  "bin": {
    "short-video-agent-kit": "src/cli.js",
    "short-video-mcp": "src/index.js"
  },
  "scripts": {
    "check": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test && npm run test:metadata && npm run test:skill-surface && npm run test:input-limits",
    "doctor": "node src/cli.js doctor",
    "manifest": "node src/cli.js manifest",
    "privacy": "node src/cli.js privacy-audit",
    "start": "node src/index.js",
    "test:metadata": "node scripts/metadata-check.mjs",
    "prepublishOnly": "npm test",
    "test:skill-surface": "node scripts/test-skill-surface.mjs",
    "test:input-limits": "node scripts/input-boundaries.mjs"
  },
  "keywords": [
    "ai-agents",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "agent-tools",
    "agentic-workflows",
    "sora",
    "veo",
    "gemini",
    "xai",
    "seedance",
    "video-generation",
    "creator-tools",
    "local-first"
  ],
  "author": "David Mosiah",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "examples",
    "llms.txt",
    "server.json",
    "README.md",
    "LICENSE",
    ".env.example",
    "skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidmosiah/short-video-agent-kit.git"
  },
  "bugs": {
    "url": "https://github.com/davidmosiah/short-video-agent-kit/issues",
    "email": "support@delx.ai"
  },
  "homepage": "https://github.com/davidmosiah/short-video-agent-kit",
  "overrides": {
    "qs": "6.16.1",
    "hono": "4.13.11",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.4",
    "@hono/node-server": "2.1.3",
    "body-parser": "2.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
